{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The workbench windows. Only Blaze IDE's own commands plus event listening; no filesystem, shell or HTTP plugin is exposed to the page.",
  "windows": [
    "main",
    "w-*"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-set-title",
    "core:app:allow-version",
    "allow-auth-get-session",
    "allow-auth-sign-in",
    "allow-auth-cancel",
    "allow-auth-logout",
    "allow-auth-get-usage",
    "allow-check-version",
    "allow-install-update",
    "allow-fs-open-folder",
    "allow-fs-read-tree",
    "allow-fs-read-file",
    "allow-fs-try-read-file",
    "allow-fs-write-file",
    "allow-fs-create-file",
    "allow-fs-create-folder",
    "allow-fs-rename",
    "allow-fs-delete",
    "allow-fs-search",
    "allow-fs-replace",
    "allow-fs-watch",
    "allow-fs-unwatch",
    "allow-get-recent-projects",
    "allow-term-create",
    "allow-term-write",
    "allow-term-resize",
    "allow-term-kill",
    "allow-ai-send",
    "allow-ai-cancel",
    "allow-ai-get-models",
    "allow-ai-refresh-models",
    "allow-ai-run-tool",
    "allow-ai-generate-media",
    "allow-ai-complete",
    "allow-providers-list",
    "allow-providers-save",
    "allow-providers-delete",
    "allow-providers-fetch-models",
    "allow-ext-search",
    "allow-ext-install",
    "allow-ext-uninstall",
    "allow-ext-list",
    "allow-ext-contributions",
    "allow-chat-list",
    "allow-chat-load",
    "allow-chat-save",
    "allow-chat-delete",
    "allow-settings-get",
    "allow-settings-set",
    "allow-open-external",
    "allow-pick-media",
    "allow-win-new",
    "allow-win-open-file"
  ]
}
